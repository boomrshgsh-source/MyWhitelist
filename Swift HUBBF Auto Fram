--// เช็คว่า "มีเควสอยู่ไหม"
local function HasQuest()
    local gui = LP.PlayerGui.Main
    return gui.Quest.Visible and gui.Quest.Container.QuestTitle.Title.Text ~= ""
end

--// Loop ฟาร์ม
task.spawn(function()
    while task.wait(0.3) do
        if not _G.AutoFarm then continue end

        pcall(function()
            CheckLevel()

            if not HasQuest() then
                TweenTo(PQ)
                task.wait(0.3)

                ReplicatedStorage.Remotes.CommF_:InvokeServer(
                    "StartQuest",
                    NQ,
                    Number
                )
                return 
            end

            local foundTarget = false
            for _, v in pairs(workspace.Enemies:GetChildren()) do
                if not HasQuest() then return end

                local root = v:FindFirstChild("HumanoidRootPart")
                local hum = v:FindFirstChildOfClass("Humanoid")

                if root and hum and hum.Health > 0 and v.Name == NM then
                    foundTarget = true

                    if (LP.Character.HumanoidRootPart.Position - root.Position).Magnitude > 15 then
                        TweenTo(root.CFrame * HeadOffset)
                    end

                    repeat
                        task.wait()
                        if not HasQuest() then return end
                        TPTo(root.CFrame * HeadOffset)
                    until hum.Health <= 0
                end
            end

            -- ถ้าไม่มีมอนเกิด → ไปยืนรอจุด WM
            if not foundTarget then
                TweenTo(WM)
            end
        end)
    end
end)

