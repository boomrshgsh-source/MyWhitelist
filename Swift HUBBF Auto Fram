--// Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

--// Player
local LP = Players.LocalPlayer
local EnemiesFolder = Workspace:WaitForChild("Enemies")

--// Settings
_G.AutoFarm = true
local TweenSpeed = 300
local HeadOffset = CFrame.new(0, 10, 0)
local ATTACK_RANGE = 25

--// Tween
local function TweenTo(pos)
    local hrp = LP.Character:WaitForChild("HumanoidRootPart")
    local distance = (hrp.Position - pos.Position).Magnitude
    local tweenInfo = TweenInfo.new(distance / TweenSpeed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = pos})
    tween:Play()
    tween.Completed:Wait()
end

--// TP
local function TPTo(pos)
    local hrp = LP.Character:WaitForChild("HumanoidRootPart")
    hrp.CFrame = pos
end

--// เช็คเลเวล
local NM, NQ, Number, PQ, WM
local function CheckLevel()
    local lv = LP.Data.Level.Value

    if lv <= 100 then
        NM = "Bandit"
        NQ = "BanditQuest1"
        Number = 1
        PQ = CFrame.new(1059, 16, 1552)
        WM = CFrame.new(1060, 16, 1555)

    elseif lv <= 3 then
        NM = "Monkey"
        NQ = "JungleQuest"
        Number = 1
        PQ = CFrame.new(-1600, 36, 150)
        WM = CFrame.new(-1605, 36, 160)

    elseif lv <= 5 then
        NM = "Gorilla"
        NQ = "JungleQuest"
        Number = 2
        PQ = CFrame.new(-1600, 36, 150)
        WM = CFrame.new(-1610, 36, 155)
    end
end

--// เช็คว่า "มีเควสอยู่ไหม"
local function HasQuest()
    local gui = LP.PlayerGui.Main
    return gui.Quest.Visible and gui.Quest.Container.QuestTitle.Title.Text ~= ""
end

--// Merge NM
local function MergeNM()
    local nmMobs = {}
    
    -- เก็บมอนสเตอร์ NM ทั้งหมด
    for _, mob in pairs(EnemiesFolder:GetChildren()) do
        if mob.Name == NM and mob:FindFirstChild("HumanoidRootPart") then
            table.insert(nmMobs, mob)
        end
    end

    -- รวมทุกตัวเข้าด้วยกัน
    for i = 1, #nmMobs do
        for j = i + 1, #nmMobs do
            local v = nmMobs[i]
            local y = nmMobs[j]

            if v and y and v.Parent and y.Parent then
                v.HumanoidRootPart.CFrame = y.HumanoidRootPart.CFrame

                -- ปรับขนาดและคุณสมบัติ
                v.HumanoidRootPart.Size = Vector3.new(60,60,60)
                y.HumanoidRootPart.Size = Vector3.new(60,60,60)
                v.HumanoidRootPart.Transparency = 1
                v.HumanoidRootPart.CanCollide = false
                y.HumanoidRootPart.CanCollide = false
                v.Humanoid.WalkSpeed = 0
                y.Humanoid.WalkSpeed = 0
                v.Humanoid.JumpPower = 0
                y.Humanoid.JumpPower = 0

                -- SimulationRadius
                if sethiddenproperty then
                    sethiddenproperty(LP, "SimulationRadius", math.huge)
                end
            end
        end
    end
end

--// Loop ฟาร์ม
task.spawn(function()
    while task.wait(0.3) do
        if not _G.AutoFarm then continue end
        pcall(function()
            CheckLevel()

            -- รับเควสถ้าไม่มี
            if not HasQuest() then
                TweenTo(PQ)
                task.wait(0.3)
                ReplicatedStorage.Remotes.CommF_:InvokeServer(NQ, Number)
                return 
            end

            local foundTarget = false
            for _, v in pairs(EnemiesFolder:GetChildren()) do
                if not HasQuest() then return end

                local root = v:FindFirstChild("HumanoidRootPart")
                local hum = v:FindFirstChildOfClass("Humanoid")

                if root and hum and hum.Health > 0 and v.Name == NM then
                    foundTarget = true

                    if (LP.Character.HumanoidRootPart.Position - root.Position).Magnitude > 15 then
                        TweenTo(root.CFrame * HeadOffset)
                    end

                    repeat
                        task.wait()
                        if not HasQuest() then return end
                        TPTo(root.CFrame * HeadOffset)
                    until hum.Health <= 0
                end
            end

            -- ถ้าไม่มีมอนเกิด → ไปยืนรอจุด WM
            if not foundTarget then
                TweenTo(WM)
            end
        end)
    end
end)

-- เรียก CheckLevel() ครั้งแรก
CheckLevel()

--// Auto Attack
local RegisterAttack = ReplicatedStorage.Modules.Net["RE/RegisterAttack"]
local RegisterHit = ReplicatedStorage.Modules.Net["RE/RegisterHit"]

local function AutoAttack()
    if not _G.AutoFarm then return end
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    CheckLevel() -- อัปเดต NM/WL

    for _, mob in pairs(EnemiesFolder:GetChildren()) do
        if mob.Name == NM and mob:FindFirstChild("HumanoidRootPart") then
            local dist = (mob.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
            if dist <= ATTACK_RANGE then
                RegisterAttack:FireServer(0.01)
                RegisterHit:FireServer(mob.HumanoidRootPart, {}, "002a98fe")
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.01) do
        pcall(AutoAttack)
    end
end)

--// Merge NM ทุกเฟรม
RunService.Heartbeat:Connect(function()
    pcall(MergeNM)
end)
