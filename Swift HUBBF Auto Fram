--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

--// Player
local LP = Players.LocalPlayer

--// Settings
_G.AutoFarm = true       -- เปิด/ปิดระบบฟาร์ม+ตีออโต้
local TweenSpeed = 300
local HeadOffset = CFrame.new(0, 20, 0)
local ATTACK_RANGE = 25

--// Tween function
local function TweenTo(pos)
    local hrp = LP.Character:WaitForChild("HumanoidRootPart")
    local distance = (hrp.Position - pos.Position).Magnitude
    local tweenInfo = TweenInfo.new(distance / TweenSpeed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = pos})
    tween:Play()
    tween.Completed:Wait()
end

--// TP function
local function TPTo(pos)
    local hrp = LP.Character:WaitForChild("HumanoidRootPart")
    hrp.CFrame = pos
end

--// Check level and set target
local NM, NQ, Number, PQ
local function CheckLevel()
    local lv = LP.Data.Level.Value

    if lv <= 100 then
        NM = "Bandit"
        NQ = "BanditQuest1"
        Number = 1
        PQ = CFrame.new(1059, 16, 1552)

    elseif lv <= 3 then
        NM = "Monkey"
        NQ = "JungleQuest"
        Number = 1
        PQ = CFrame.new(-1600, 36, 150)

    elseif lv <= 5 then
        NM = "Gorilla"
        NQ = "JungleQuest"
        Number = 2
        PQ = CFrame.new(-1600, 36, 150)
    end
end

--// Check if player has quest
local function HasQuest()
    local gui = LP.PlayerGui.Main
    return gui.Quest.Visible and gui.Quest.Container.QuestTitle.Title.Text ~= "NQ"
end

--// AutoAttack function
local RegisterAttack = ReplicatedStorage.Modules.Net["RE/RegisterAttack"]
local RegisterHit = ReplicatedStorage.Modules.Net["RE/RegisterHit"]

local function AutoAttack(mob)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not mob or not mob:FindFirstChild("HumanoidRootPart") then return end

    local dist = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude
    if dist <= ATTACK_RANGE then
        RegisterAttack:FireServer(0.01)
        RegisterHit:FireServer(mob.HumanoidRootPart, {}, "002a98fe")
        task.wait(0.05)
    end
end

--// Main AutoFarm loop
task.spawn(function()
    while task.wait(0.2) do
        if not _G.AutoFarm then continue end

        pcall(function()
            CheckLevel()

            -- ถ้าเควสหาย → ไปเอาเควสใหม่
            if not HasQuest() then
                TweenTo(PQ)
                task.wait(0.3)
                ReplicatedStorage.Remotes.CommF_:InvokeServer(NQ, Number)
                task.wait(0.5)
            end

            -- เก็บมอนเป้าหมายทั้งหมด
            local targets = {}
            for _, mob in pairs(workspace.Enemies:GetChildren()) do
                if mob.Name == NM
                   and mob:FindFirstChild("HumanoidRootPart")
                   and mob:FindFirstChildOfClass("Humanoid")
                   and mob.Humanoid.Health > 0 then
                    table.insert(targets, mob)
                end
            end

            -- Loop ตีทุกตัว
            for _, mob in pairs(targets) do
                if not HasQuest() then break end
                local root = mob.HumanoidRootPart

                if (LP.Character.HumanoidRootPart.Position - root.Position).Magnitude > 15 then
                    TPTo(root.CFrame * HeadOffset)
                end

                repeat
                    task.wait(0.01)
                    if not HasQuest() then break end
                    TPTo(root.CFrame * HeadOffset)
                    AutoAttack(mob)
                until mob.Humanoid.Health <= 0
            end
        end)
    end
end)
