--// Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local EnemiesFolder = Workspace:WaitForChild("Enemies")

--// BringMob / MergeMob แบบนิ่ง
local function BringMob()
    local mobs = {}

    for _, mob in pairs(EnemiesFolder:GetChildren()) do
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        local hum = mob:FindFirstChildOfClass("Humanoid")

        if hrp and hum and hum.Health > 0 then
            table.insert(mobs, mob)
        end
    end

    if #mobs <= 1 then return end

    -- ใช้ตำแหน่งมอนตัวแรกเป็นฐาน
    local baseHRP = mobs[1].HumanoidRootPart
    local baseCF = baseHRP.CFrame

    for i = 2, #mobs do
        local mob = mobs[i]
        local hrp = mob.HumanoidRootPart
        local hum = mob.Humanoid

        -- ล็อกตำแหน่ง
        hrp.CFrame = baseCF
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        -- กันกระเด้ง
        hrp.CanCollide = false
        hrp.Massless = true
        hrp.Size = Vector3.new(60,60,60)
        hrp.Transparency = 1

        -- หยุดการเคลื่อนไหว
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.AutoRotate = false
    end

    -- ตัวฐานก็ล็อกเหมือนกัน
    baseHRP.CanCollide = false
    baseHRP.Massless = true
    baseHRP.Size = Vector3.new(60,60,60)
    baseHRP.Transparency = 1
    mobs[1].Humanoid.WalkSpeed = 0
    mobs[1].Humanoid.JumpPower = 0
    mobs[1].Humanoid.AutoRotate = false

    -- ขยาย SimulationRadius
    if sethiddenproperty then
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end
end

-- รันทุกเฟรม
RunService.Heartbeat:Connect(BringMob)
