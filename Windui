    Resizable = true,

    -- ⭐ ขนาด UI
    Size = UDim2.fromOffset(850, 400),   -- ขนาดเริ่มต้น (ใหญ่ขึ้น)
    MinSize = Vector2.new(480, 480),     -- เล็กสุด
    MaxSize = Vector2.new(1000, 500),    -- ใหญ่สุด
