--================= SWIFT HUB WHITELIST =================--

-- ลิงก์ Raw JSON ของ Key/HWID
local GIST_RAW   = "https://raw.githubusercontent.com/boomrshgsh-source/MyWhitelist/main/whitelist.json"

-- API สำหรับ PATCH HWID (ต้องมี GitHub Token)
local GIST_API   = "https://api.github.com/gists/06a3e054df764e01ec58feb6889b87f9"
local TOKEN      = "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"

-- ลิงก์สคริปต์จริงที่จะโหลดหลังเช็ค Key/HWID
local MAIN_SCRIPT = "https://raw.githubusercontent.com/boomrshgsh-source/MyWhitelist/main/Test.lua"

local Key = _G.Key

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RbxAnalyticsService = game:GetService("RbxAnalyticsService")
local LocalPlayer = Players.LocalPlayer
local HWID = RbxAnalyticsService:GetClientId()

local function Kick(msg)
    LocalPlayer:Kick(msg or "[Swift HUB]\nInvalid Key")
end

if not Key then
    Kick("[Swift HUB]\nPlease insert key")
end

-- โหลด DB
local success, DB = pcall(function()
    return HttpService:JSONDecode(game:HttpGet(GIST_RAW))
end)
if not success or type(DB) ~= "table" then
    Kick("[Swift HUB]\nCannot load database")
end

local data = DB[Key]
if not data or type(data) ~= "table" then
    Kick("[Swift HUB]\nInvalid Key or bad format")
end

-- เช็ควันหมดอายุ
if data.expired and tonumber(data.expired) ~= 0 then
    if os.time() > tonumber(data.expired) then
        Kick("[Swift HUB]\nKey expired")
    end
end

-- ============ AUTO HWID BIND ============
if not data.hwid or data.hwid == "" then
    DB[Key].hwid = HWID

    local body = HttpService:JSONEncode({
        files = {
            ["whitelist.json"] = {
                content = HttpService:JSONEncode(DB)
            }
        }
    })

    local ok = pcall(function()
        game:HttpRequest({
            Url = GIST_API,
            Method = "PATCH",
            Headers = {
                ["Authorization"] = "token " .. TOKEN,
                ["Content-Type"] = "application/json"
            },
            Body = body
        })
    end)

    if not ok then
        Kick("[Swift HUB]\nHWID bind failed")
    end
else
    if tostring(data.hwid) ~= tostring(HWID) then
        Kick("[Swift HUB]\nInvalid HWID")
    end
end

-- ผ่านไวลิส → โหลดสคริปต์จริงจาก GitHub
loadstring(game:HttpGet(MAIN_SCRIPT))()
