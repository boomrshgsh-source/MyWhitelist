    corner.CornerRadius = UDim.new(0, 16)

    -- Neon Border  
    local border = Instance.new("UIStroke", mainFrame)  
    border.Thickness = 3
    local borderGradient = Instance.new("UIGradient", border)  
    borderGradient.Color = ColorSequence.new(THEME_COLOR_1, THEME_COLOR_2)  

    -- Title  
    local title = Instance.new("TextLabel", mainFrame)  
    title.Size = UDim2.new(1, 0, 0, 70)  
    title.Position = UDim2.new(0, 0, 0, 0)
    title.Text = "SWIFT HUB"  
    title.TextSize = 38  
    title.Font = Enum.Font.GothamBlack  
    title.BackgroundTransparency = 1  
    title.TextColor3 = Color3.new(1, 1, 1)
    
    local titleGradient = Instance.new("UIGradient", title)  
    titleGradient.Color = borderGradient.Color

    -- Key Input
    local keyBox = Instance.new("TextBox", mainFrame)  
    keyBox.Size = UDim2.new(0.85, 0, 0, 45)  
    keyBox.Position = UDim2.new(0.075, 0, 0.45, 0)  
    keyBox.PlaceholderText = "ENTER LICENSE KEY"  
    keyBox.Text = ""
    keyBox.Font = Enum.Font.GothamSemibold
    keyBox.TextSize = 16
    keyBox.TextColor3 = Color3.new(1, 1, 1)
    keyBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    
    local keyCorner = Instance.new("UICorner", keyBox)
    keyCorner.CornerRadius = UDim.new(0, 8)
    
    local keyStroke = Instance.new("UIStroke", keyBox)
    keyStroke.Thickness = 1
    keyStroke.Color = Color3.fromRGB(100, 100, 100)

    -- Verify Button
    local verifyBtn = Instance.new("TextButton", mainFrame)  
    verifyBtn.Size = UDim2.new(0.85, 0, 0, 45)  
    verifyBtn.Position = UDim2.new(0.075, 0, 0.72, 0)  
    verifyBtn.Text = "VERIFY & BIND HWID"  
    verifyBtn.Font = Enum.Font.GothamBold
    verifyBtn.TextSize = 18
    verifyBtn.TextColor3 = Color3.new(1, 1, 1)
    verifyBtn.Name = "VerifyButton"
    
    local btnCorner = Instance.new("UICorner", verifyBtn)
    btnCorner.CornerRadius = UDim.new(0, 8)
    
    local btnGradient = Instance.new("UIGradient", verifyBtn)  
    btnGradient.Color = borderGradient.Color

    -- Button Hover Effects
    verifyBtn.MouseEnter:Connect(function()
        TweenService:Create(verifyBtn, TweenInfo.new(0.2), {Size = UDim2.new(0.87, 0, 0, 48)}):Play()
    end)
    
    verifyBtn.MouseLeave:Connect(function()
        TweenService:Create(verifyBtn, TweenInfo.new(0.2), {Size = UDim2.new(0.85, 0, 0, 45)}):Play()
    end)

    -- Verify Logic
    verifyBtn.MouseButton1Click:Connect(function()
        local key = keyBox.Text:gsub("%s+", "")
        
        if #key < 5 then
            showNotification("Invalid Key Format")
            return
        end
        
        -- ดึง whitelist
        local whitelist = fetchWhitelist()
        
        if not whitelist then
            showNotification("Network Error")
            return
        end
        
        -- ตรวจสอบ key
        if not whitelist[key] then
            showNotification("Invalid License Key")
            return
        end
        
        -- ตรวจสอบว่า key ถูกใช้แล้วหรือยัง
        if whitelist[key] ~= "" and whitelist[key] ~= HWID then
            showNotification("Key Already Used")
            return
        end
        
        -- Bind HWID
        whitelist[key] = HWID
        local result = updateWhitelist(whitelist)
        
        if result and result.StatusCode == 200 then
            showNotification("Success! Loading Hub...")
            
            -- ปิด UI
            gui:Destroy()
            
            -- โหลดและรันสคริปต์จาก Pastebin
            local success, hubScript = pcall(function()
                return game:HttpGet("https://pastebin.com/raw/u8dTmTes")
            end)
            
            if success then
                local success2, err = pcall(loadstring, hubScript)
                if not success2 then
                    showNotification("Load Error: " .. tostring(err))
                end
            else
                showNotification("Failed to load from Pastebin")
            end
        else
            showNotification("Update Failed")
        end
    end)
    
    return gui
end

-- ========== STARTUP ==========
local function startSwiftHub()
    -- ดึง whitelist
    local whitelist = fetchWhitelist()
    
    -- ตรวจสอบว่า HWID ถูก whitelist แล้วหรือไม่
    for key, hwid in pairs(whitelist) do
        if hwid == HWID then
            showNotification("Welcome back! Loading...")
            
            -- โหลดและรันสคริปต์จาก Pastebin
            local success, hubScript = pcall(function()
                return game:HttpGet("https://pastebin.com/raw/u8dTmTes")
            end)
            
            if success then
                local success2, err = pcall(loadstring, hubScript)
                if not success2 then
                    showNotification("Load Error")
                    createKeyInputUI()
                end
            else
                showNotification("Network Error")
                createKeyInputUI()
            end
            
            return
        end
    end
    
    -- ถ้ายังไม่ถูก whitelist, แสดง UI กรอกคีย์
    createKeyInputUI()
end

-- เริ่มทำงาน
startSwiftHub()
