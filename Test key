end

-- ================= MAIN UI =================
local function startSwiftHub()
    local data = fetchWhitelist()
    if not data then return end

    -- HWID already in whitelist
    for k,v in pairs(data) do
        if v==HWID then
            showNotification("Access Granted")
            loadstring(game:HttpGet(HUB_SCRIPT_URL))()
            return
        end
    end

    -- Create key input UI
    local gui=Instance.new("ScreenGui",PlayerGui)
    local f=Instance.new("Frame",gui)
    f.Size=UDim2.new(0,400,0,240)
    f.Position=UDim2.new(.5,0,.5,0)
    f.AnchorPoint=Vector2.new(.5,.5)
    f.BackgroundColor3=BG_COLOR
    Instance.new("UICorner",f).CornerRadius=UDim.new(0,16)

    -- Neon Border
    local b=Instance.new("UIStroke",f)
    local bg=Instance.new("UIGradient",b)
    bg.Color=ColorSequence.new(THEME_COLOR_1,THEME_COLOR_2)

    -- Logo
    local title=Instance.new("TextLabel",f)
    title.Size=UDim2.new(1,0,0,70)
    title.Text="SWIFT HUB"
    title.TextSize=38
    title.Font=Enum.Font.GothamBlack
    title.BackgroundTransparency=1
    local tg=Instance.new("UIGradient",title)
    tg.Color=bg.Color

    -- Key Box
    local box=Instance.new("TextBox",f)
    box.Size=UDim2.new(.85,0,0,45)
    box.Position=UDim2.new(.075,0,.45,0)
    box.PlaceholderText="ENTER KEY"

    -- Verify Button
    local btn=Instance.new("TextButton",f)
    btn.Size=UDim2.new(.85,0,0,45)
    btn.Position=UDim2.new(.075,0,.72,0)
    btn.Text="VERIFY AND BIND"
    local btg=Instance.new("UIGradient",btn)
    btg.Color=bg.Color

    -- Button Callback
    btn.MouseButton1Click:Connect(function()
        local k=box.Text
        if not data[k] then
            showNotification("Invalid Key")
            return
        end
        if data[k]=="" then
            data[k]=HWID
            if updateWhitelist(data) then
                showNotification("Bind Success")
                gui:Destroy()
                loadstring(game:HttpGet(HUB_SCRIPT_URL))()
            else
                showNotification("Failed to bind key")
            end
        else
            showNotification("Key Already Used")
        end
    end)
end

-- Start Swift Hub
startSwiftHub()
