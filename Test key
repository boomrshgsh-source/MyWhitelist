-- ================= THEME =================
local THEME_COLOR_1 = Color3.fromRGB(0,255,200)
local THEME_COLOR_2 = Color3.fromRGB(0,180,255)
local BG_COLOR = Color3.fromRGB(12,12,12)

-- ================= HWID =================
local HWID = game:GetService("RbxAnalyticsService"):GetClientId()

-- ================= SWIFT HUB SECURITY CORE =================
do
    -- Disable HttpGet / namecall bypass
    local rawmt = getrawmetatable(game)
    setreadonly(rawmt,false)

    local oldNamecall = rawmt.__namecall
    rawmt.__namecall = newcclosure(function(self,...)
        local method = getnamecallmethod()
        if tostring(method) == "HttpGet" or tostring(method) == "HttpPost" then
            Players.LocalPlayer:Kick("HttpGet Blocked")
            return
        end
        return oldNamecall(self,...)
    end)

    setreadonly(rawmt,true)

    -- Capture real HTTP engine
    local RAW_REQUEST =
        (syn and syn.request)
        or http_request
        or request
        or (fluxus and fluxus.request)

    if not RAW_REQUEST then
        Players.LocalPlayer:Kick("Executor not supported")
        return
    end

    local SAFE_REQUEST = RAW_REQUEST

    -- Secure HTTP wrapper
    local function safeRequest(opt)
        if SAFE_REQUEST ~= RAW_REQUEST then
            Players.LocalPlayer:Kick("HTTP Hook Detected")
            return
        end
        if type(opt) ~= "table" or not opt.Url then
            Players.LocalPlayer:Kick("Invalid HTTP Call")
            return
        end
        opt.Headers = opt.Headers or {}
        opt.Headers["X-Swift-Security"] = "SwiftHub-Protected"
        return SAFE_REQUEST(opt)
    end

    -- Background watchdog
    task.spawn(function()
        while task.wait(1.5) do
            if SAFE_REQUEST ~= RAW_REQUEST then
                Players.LocalPlayer:Kick("Security Violation")
                break
            end
        end
    end)

    -- Public API
    httpRequest = safeRequest
end

-- ================= WHITELIST FUNCTIONS =================
local function fetchWhitelist()
    local h = {["Authorization"]="token "..TOKEN, ["User-Agent"]="Roblox"}
    local r = httpRequest({Url="https://api.github.com/gists/"..GIST_ID, Method="GET", Headers=h})
    if r and r.StatusCode == 200 then
        local g = HttpService:JSONDecode(r.Body)
        return HttpService:JSONDecode(g.files["whitelist.json"].content)
    end
end

local function updateWhitelist(data)
    local h = {["Authorization"]="token "..TOKEN, ["Content-Type"]="application/json"}
    local success, res = pcall(function()
        return httpRequest({
            Url="https://api.github.com/gists/"..GIST_ID,
            Method="PATCH",
            Headers=h,
            Body=HttpService:JSONEncode({files={["whitelist.json"]={content=HttpService:JSONEncode(data)}}})
        })
    end)
    if success and res and res.StatusCode==200 then
        return true
    else
        warn("Failed to update whitelist!", res)
        return false
    end
end

