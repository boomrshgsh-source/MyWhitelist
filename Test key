                syn.request({
                    Url="https://api.github.com/gists/"..GIST_ID,
                    Method="PATCH",
                    Headers={["Authorization"]="token "..TOKEN, ["User-Agent"]="Roblox"},
                    Body=payload
                })
            end
        end

        -- ตรวจสอบ HWID อีกครั้ง
        if data[userKey] ~= HWID then
            LocalPlayer:Kick("HWID Mismatch - Key already used")
            return
        end

        showNotification("Swift HUB Whitelist ✅")
        ScreenGui:Destroy()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/reothebest13-art/ERRORHUB.lua/refs/heads/main/ERRORHUB%20ALLMap"))()
    end)
end

