-- ========== HWID FUNCTION ==========
local function getHWID()
    local success, hwid = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    return success and hwid or "HWID_" .. tostring(math.random(100000,999999))
end
local HWID = getHWID()
print("HWID:", HWID)

-- ========== GIST FETCH FUNCTION ==========
local function fetchWhitelist()
    local API = "https://api.github.com/gists/" .. GIST_ID
    local headers = {
        ["Authorization"] = "token " .. TOKEN,
        ["User-Agent"] = "Roblox"
    }
    local response
    local success, err = pcall(function()
        if syn and syn.request then
            response = syn.request({
                Url = API,
                Method = "GET",
                Headers = headers
            }).Body
        else
            response = game:HttpGet(API, true, headers)
        end
    end)
    if not success then
        LocalPlayer:Kick("Cannot connect to whitelist")
        return nil
    end

    local gist = HttpService:JSONDecode(response)
    local data = HttpService:JSONDecode(gist.files["whitelist.json"].content)
    return data
end

-- ========== CHECK HWID FUNCTION ==========
local function findKeyByHWID(data, hwid)
    for key, storedHWID in pairs(data) do
        if storedHWID == hwid then
            return key
        end
    end
    return nil
end

