--================================
-- GET SERVER TIME (GitHub)
--================================
local function getServerTime()
    local res = request({
        Url = "https://api.github.com",
        Method = "GET",
        Headers = {
            ["User-Agent"] = "Time-Check"
        }
    })

    local date = res.Headers["Date"] or res.Headers["date"]
    -- example: Wed, 15 Jan 2026 15:30:00 GMT
    local d, m, y, h, mi, s = date:match("%a+, (%d+) (%a+) (%d+) (%d+):(%d+):(%d+)")

    local months = {
        Jan=1, Feb=2, Mar=3, Apr=4, May=5, Jun=6,
        Jul=7, Aug=8, Sep=9, Oct=10, Nov=11, Dec=12
    }

    return os.time({
        year = tonumber(y),
        month = months[m],
        day = tonumber(d),
        hour = tonumber(h),
        min = tonumber(mi),
        sec = tonumber(s)
    })
end

local NOW = getServerTime()

--================================
-- CHECK KEY
--================================
if not _G.Key then
    lp:Kick("No Key Provided")
    return
end
local USER_KEY = tostring(_G.Key)

--================================
-- HWID
--================================
local HWID = lp.UserId .. "-" .. lp.AccountAge

--================================
-- LOAD GIST
--================================
local res = request({
    Url = GIST_API,
    Method = "GET",
    Headers = {
        ["Authorization"] = "token " .. GITHUB_TOKEN,
        ["User-Agent"] = "Roblox-Whitelist"
    }
})

local gist = HttpService:JSONDecode(res.Body)
local keys = HttpService:JSONDecode(gist.files[FILE_NAME].content)

local info = keys[USER_KEY]
if not info then
    lp:Kick("Invalid Key")
    return
end

--================================
-- PERMANENT KEY
--================================
if info.expire == "permanent" then
    if info.used == false then
        info.used = true
        info.hwid = HWID
    elseif info.hwid ~= HWID then
        lp:Kick("HWID mismatch")
        return
    end
else
    --================================
    -- TIME LIMITED KEY
    --================================
    if info.used == false then
        info.used = true
        info.hwid = HWID
        info.start = NOW
    end

    local expireTime = info.start + (info.duration * 86400)
    if NOW >= expireTime then
        lp:Kick("Key Expired")
        return
    end

    if info.hwid ~= HWID then
        lp:Kick("HWID mismatch")
        return
    end
end

--================================
-- SAVE UPDATE
--================================
request({
    Url = GIST_API,
    Method = "PATCH",
    Headers = {
        ["Authorization"] = "token " .. GITHUB_TOKEN,
        ["Content-Type"] = "application/json",
        ["User-Agent"] = "Roblox-Whitelist"
    },
    Body = HttpService:JSONEncode({
        files = {
            [FILE_NAME] = {
                content = HttpService:JSONEncode(keys)
            }
        }
    })
})

