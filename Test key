-- CONFIG
local GIST_ID = "06a3e054df764e01ec58feb6889b87f9"
local FILE = "whitelist.json"
local TOKEN = "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" -- ห้ามแจก

local request = request or http_request or (syn and syn.request)
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer

if not _G.Key then
    lp:Kick("No Key")
    return
end

-- LOAD GIST
local res = request({
    Url = "https://api.github.com/gists/" .. GIST_ID,
    Method = "GET",
    Headers = {
        ["Authorization"] = "token " .. TOKEN,
        ["User-Agent"] = "Roblox"
    }
})

local gist = HttpService:JSONDecode(res.Body)
local keys = HttpService:JSONDecode(gist.files[FILE].content)

local key = keys[_G.Key]
if not key then
    lp:Kick("Invalid Key")
    return
end

local HWID = lp.UserId .. "-" .. lp.AccountAge
local NOW = getServerTime()

-- PERMA
if key.expire == "permanent" then
    if not key.used then
        key.used = true
        key.hwid = HWID
    elseif key.hwid ~= HWID then
        lp:Kick("HWID mismatch")
        return
    end
else
    if not key.used then
        key.used = true
        key.hwid = HWID
        key.start = NOW
    end

    if NOW >= key.start + key.duration * 86400 then
        lp:Kick("Key Expired")
        return
    end

    if key.hwid ~= HWID then
        lp:Kick("HWID mismatch")
        return
    end
end

-- SAVE
request({
    Url = "https://api.github.com/gists/" .. GIST_ID,
    Method = "PATCH",
    Headers = {
        ["Authorization"] = "token " .. TOKEN,
        ["Content-Type"] = "application/json",
        ["User-Agent"] = "Roblox"
    },
    Body = HttpService:JSONEncode({
        files = {
            [FILE] = {
                content = HttpService:JSONEncode(keys)
            }
        }
    })
})

print("✅ ผ่าน Whitelist")
