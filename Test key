-- --- ตรวจ Key + HWID + Expire ---
local function CheckKey(key)
    local success, response = pcall(function()
        return game:HttpGet(RAW_URL)
    end)
    if not success then
        ShowNotification("❌ Cannot fetch whitelist")
        return false
    end

    local data = HttpService:JSONDecode(response)
    local info = data[key]
    if not info then
        ShowNotification("❌ Invalid Key")
        return false
    end

    -- ตรวจวันหมดอายุ
    if info.expires and info.expires ~= "" then
        local y,m,d,h,min = string.match(info.expires,"(%d+)-(%d+)-(%d+)T(%d+):(%d+)")
        local expTime = os.time({year=tonumber(y), month=tonumber(m), day=tonumber(d), hour=tonumber(h), min=tonumber(min)})
        if os.time() > expTime then
            ShowNotification("❌ Key Expired")
            return false
        end
    end

    -- ตรวจ HWID
    if info.HWID and info.HWID ~= "" then
        if info.HWID ~= HWID then
            ShowNotification("❌ HWID Mismatch")
            return false
        end
    else
        -- ผูก HWID อัตโนมัติ
        info.HWID = HWID
        data[key] = info
        -- อัปเดตกลับ Gist
        local payload = HttpService:JSONEncode({files={["whitelist.json"]={content=HttpService:JSONEncode(data)}}})
        if syn and syn.request then
            syn.request({
                Url = "https://api.github.com/gists/06a3e054df764e01ec58feb6889b87f9", -- เปลี่ยนเป็น Gist ID ของคุณ
                Method = "PATCH",
                Headers = {["Authorization"]="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", ["User-Agent"]="Roblox"},
                Body = payload
            })
        end
        ShowNotification("✅ HWID Bound")
    end

    ShowNotification("✅ Swift HUB Whitelist")
    return true
end

