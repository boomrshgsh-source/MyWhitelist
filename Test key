local GIST_ID = "06a3e054df764e01ec58feb6889b87f9"
local TOKEN = "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"
local HWID = game:GetService("RbxAnalyticsService"):GetClientId()

-- ========== SERVICES ==========
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- ========== THEME ==========
local THEME_COLOR_1 = Color3.fromRGB(0,255,150)
local THEME_COLOR_2 = Color3.fromRGB(0,200,255)
local BG_COLOR = Color3.fromRGB(12,12,12)

-- ========== HTTP ==========
local function httpRequest(o)
    local r = syn and syn.request or request or http_request or (fluxus and fluxus.request)
    return r(o)
end

-- ========== WHITELIST ==========
local function fetchWhitelist()
    local h = {["Authorization"]="token "..TOKEN,["User-Agent"]="Roblox"}
    local r = httpRequest({Url="https://api.github.com/gists/"..GIST_ID,Method="GET",Headers=h})
    if r and r.StatusCode==200 then
        local g = HttpService:JSONDecode(r.Body)
        return HttpService:JSONDecode(g.files["whitelist.json"].content)
    end
    return {}
end

local function updateWhitelist(data)
    local h = {["Authorization"]="token "..TOKEN,["Content-Type"]="application/json"}
    return httpRequest({
        Url="https://api.github.com/gists/"..GIST_ID,
        Method="PATCH",
        Headers=h,
        Body=HttpService:JSONEncode({files={["whitelist.json"]={content=HttpService:JSONEncode(data)}}})
    })
end

