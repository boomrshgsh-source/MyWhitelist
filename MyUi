--// Swift UI Library Neon Animated
local SwiftUI = {}
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SwiftUI"
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- Main Frame (พื้นหลังดำ)
local Main = Instance.new("Frame")
Main.Size = UDim2.new(0,520,0,350)
Main.Position = UDim2.new(0.5,-260,0.5,-175)
Main.BackgroundColor3 = Color3.fromRGB(10,10,10)
Main.BorderSizePixel = 0
Main.Active = true
Main.Draggable = true
Main.Parent = ScreenGui
Instance.new("UICorner",Main).CornerRadius = UDim.new(0,15)

-- Title
local Title = Instance.new("TextLabel",Main)
Title.Size = UDim2.new(1,0,0,40)
Title.BackgroundTransparency = 1
Title.Text = "⚡ Swift Hub"
Title.TextColor3 = Color3.fromRGB(0,255,180)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 20
local TitleGradient = Instance.new("UIGradient",Title)
TitleGradient.Color = ColorSequence.new{
    ColorSequenceKeypoint.new(0, Color3.fromRGB(0,200,255)),  -- ฟ้า
    ColorSequenceKeypoint.new(1, Color3.fromRGB(0,255,128))   -- เขียว
}

-- Tab Holder
local TabBar = Instance.new("Frame",Main)
TabBar.Position = UDim2.new(0,10,0,45)
TabBar.Size = UDim2.new(0,130,1,-55)
TabBar.BackgroundTransparency = 1
local TabLayout = Instance.new("UIListLayout",TabBar)
TabLayout.Padding = UDim.new(0,6)

-- Content Holder
local Content = Instance.new("Frame",Main)
Content.Position = UDim2.new(0,150,0,45)
Content.Size = UDim2.new(1,-160,1,-55)
Content.BackgroundTransparency = 1

-- Toggle UI Button
local ToggleButton = Instance.new("TextButton",ScreenGui)
ToggleButton.Size = UDim2.new(0,100,0,30)
ToggleButton.Position = UDim2.new(1,-110,0.5,-15)
ToggleButton.BackgroundColor3 = Color3.fromRGB(0,200,255)
ToggleButton.Text = "Toggle UI"
ToggleButton.TextColor3 = Color3.fromRGB(10,10,10)
ToggleButton.Font = Enum.Font.GothamBold
ToggleButton.TextSize = 14
Instance.new("UICorner",ToggleButton)

local uiOpen = true
ToggleButton.MouseButton1Click:Connect(function()
    uiOpen = not uiOpen
    local goal = {}
    if uiOpen then
        goal.Position = UDim2.new(0.5,-260,0.5,-175)
    else
        goal.Position = UDim2.new(0.5,-260,1.2,0) -- เลื่อนออกด้านล่าง
    end
    TweenService:Create(Main,TweenInfo.new(0.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),goal):Play()
end)

-- Store tabs
SwiftUI.Tabs = {}

-- Create Tab
function SwiftUI:CreateTab(name)
    local Tab = {}

    -- Tab Button
    local Button = Instance.new("TextButton",TabBar)
    Button.Size = UDim2.new(1,0,0,35)
    Button.BackgroundColor3 = Color3.fromRGB(25,25,25)
    Button.Text = name
    Button.TextColor3 = Color3.fromRGB(0,255,180)
    Button.Font = Enum.Font.Gotham
    Button.TextSize = 14
    Instance.new("UICorner",Button)

    -- Page
    local Page = Instance.new("ScrollingFrame",Content)
    Page.Size = UDim2.new(1,0,1,0)
    Page.CanvasSize = UDim2.new(0,0,0,0)
    Page.ScrollBarImageTransparency = 1
    Page.Visible = false
    local Layout = Instance.new("UIListLayout",Page)
    Layout.Padding = UDim.new(0,8)

    -- Button click show page
    Button.MouseButton1Click:Connect(function()
        for _,p in pairs(Content:GetChildren()) do
            if p:IsA("ScrollingFrame") then
                p.Visible = false
            end
        end
        Page.Visible = true
        -- Tween เข้า Page
        Page.Position = UDim2.new(0,0,0,50)
        TweenService:Create(Page,TweenInfo.new(0.3),{Position=UDim2.new(0,0,0,0)}):Play()
    end)

    -- Add Button Element with Animation
    function Tab:Button(text, callback)
        local Btn = Instance.new("TextButton",Page)
        Btn.Size = UDim2.new(1,0,0,35)
        Btn.BackgroundColor3 = Color3.fromRGB(25,25,25)
        Btn.Text = text
        Btn.TextColor3 = Color3.fromRGB(0,255,180)
        Btn.Font = Enum.Font.Gotham
        Btn.TextSize = 14
        Instance.new("UICorner",Btn)
        Btn.MouseButton1Click:Connect(function()
            -- Animate button click
            local goal = {BackgroundColor3=Color3.fromRGB(0,255,180)}
            local tween = TweenService:Create(Btn,TweenInfo.new(0.1,Enum.EasingStyle.Linear,Enum.EasingDirection.Out),goal)
            tween:Play()
            tween.Completed:Connect(function()
                Btn.BackgroundColor3 = Color3.fromRGB(25,25,25)
            end)
            callback()
        end)
        return Btn
    end

    -- Add Toggle with Animation
    function Tab:Toggle(text, default, callback)
        local Frame = Instance.new("Frame",Page)
        Frame.Size = UDim2.new(1,0,0,35)
        Frame.BackgroundTransparency = 1

        local Label = Instance.new("TextLabel",Frame)
        Label.Size = UDim2.new(0.8,0,1,0)
        Label.BackgroundTransparency = 1
        Label.Text = text
        Label.TextColor3 = Color3.fromRGB(0,255,180)
        Label.Font = Enum.Font.Gotham
        Label.TextSize = 14

        local Btn = Instance.new("TextButton",Frame)
        Btn.Size = UDim2.new(0.2,-5,1,0)
        Btn.Position = UDim2.new(0.8,5,0,0)
        Btn.BackgroundColor3 = default and Color3.fromRGB(0,255,180) or Color3.fromRGB(35,35,35)
        Btn.Text = ""
        Instance.new("UICorner",Btn)
        local toggled = default

        Btn.MouseButton1Click:Connect(function()
            toggled = not toggled
            local goal = {BackgroundColor3=toggled and Color3.fromRGB(0,255,180) or Color3.fromRGB(35,35,35)}
            TweenService:Create(Btn,TweenInfo.new(0.3),goal):Play()
            callback(toggled)
        end)
        return Btn
    end

    SwiftUI.Tabs[name] = Tab
    return Tab
end

return SwiftUI
