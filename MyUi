-- Tabs Management
local Tabs = {}
local Pages = {}

-- Function to create a Tab
local function createTab(name)
    local idx = #Tabs + 1

    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = "Tab_"..idx
    tabBtn.Parent = TabFrame
    tabBtn.BackgroundColor3 = COLOR_BTN_NORMAL
    tabBtn.Size = UDim2.new(1,-10,0,30)
    tabBtn.Font = Enum.Font.Gotham
    tabBtn.Text = name
    tabBtn.TextColor3 = COLOR_TEXT_PRIMARY
    tabBtn.TextSize = 16

    -- Hover effect
    tabBtn.MouseEnter:Connect(function()
        TweenService:Create(tabBtn,TweenInfo.new(0.15),{BackgroundColor3=COLOR_BTN_HOVER}):Play()
    end)
    tabBtn.MouseLeave:Connect(function()
        TweenService:Create(tabBtn,TweenInfo.new(0.15),{BackgroundColor3=COLOR_BTN_NORMAL}):Play()
    end)

    -- Create associated Page
    local page = newPage()
    page.Visible = false
    tabBtn.MouseButton1Click:Connect(function()
        -- Hide other pages
        for _,p in pairs(PageFrame:GetChildren()) do
            if p:IsA("ScrollingFrame") then p.Visible = false end
        end
        page.Visible = true
    end)

    Tabs[idx] = tabBtn
    Pages[idx] = page

    -- Return helper to add elements
    local elements = {}
    
    function elements:Button(text,callback)
        local btn = Instance.new("TextButton")
        btn.Parent = page
        btn.BackgroundColor3 = COLOR_BTN_NORMAL
        btn.Size = UDim2.new(1,-10,0,32)
        btn.Font = Enum.Font.Gotham
        btn.Text = text
        btn.TextColor3 = COLOR_TEXT_PRIMARY
        btn.TextSize = 16

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn,TweenInfo.new(0.15),{BackgroundColor3=COLOR_BTN_HOVER}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn,TweenInfo.new(0.15),{BackgroundColor3=COLOR_BTN_NORMAL}):Play()
        end)

        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    function elements:Toggle(text,default,callback)
        local toggled = default or false
        local t = Instance.new("TextButton")
        t.Parent = page
        t.BackgroundColor3 = toggled and COLOR_ACCENT or COLOR_BTN_NORMAL
        t.Size = UDim2.new(1,-10,0,32)
        t.Font = Enum.Font.Gotham
        t.Text = text.." ["..(toggled and "ON" or "OFF").."]"
        t.TextColor3 = COLOR_TEXT_PRIMARY
        t.TextSize = 16

        t.MouseButton1Click:Connect(function()
            toggled = not toggled
            t.Text = text.." ["..(toggled and "ON" or "OFF").."]"
            t.BackgroundColor3 = toggled and COLOR_ACCENT or COLOR_BTN_NORMAL
            if callback then callback(toggled) end
        end)
        return t
    end

    return elements
end
